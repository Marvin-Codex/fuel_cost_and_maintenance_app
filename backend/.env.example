# Copy this file to backend/.env and fill in your values. backend/.env is
# gitignored and never committed. See README §6 for the database contract.

# PostgreSQL (default) — e.g. Neon. Include sslmode=require for managed hosts.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# Alternative pooled Neon connection (optional).
# DATABASE_URL_POOLED=postgresql://user:password@host-pooler:5432/dbname?sslmode=require

# Explicit opt-in SQLite fallback (only when no Postgres is available).
# USE_SQLITE=1

# Django
# SECRET_KEY=change-me
# DEBUG=True
# ALLOWED_HOSTS=localhost,127.0.0.1
# JWT token lifetimes (minutes / days). Defaults: 60 min access, 30 days refresh.
# JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
# JWT_REFRESH_TOKEN_LIFETIME_DAYS=30

# OSRM routing (optional override; defaults to the public demo server).
# NOTE: router.project-osrm.org is a public demo server — it is unreliable and
# rate-limited. Run a self-hosted OSRM instance (osrm/osrm-backend + a .pbf
# extract) for dependable route planning and set OSRM_BASE_URL to it.
# OSRM_BASE_URL=https://router.project-osrm.org
# Seconds to wait for the OSRM instance before a straight-line fallback is
# returned (default 10).
# OSRM_TIMEOUT=10
# Retries after a transient OSRM failure (default 1).
# OSRM_RETRIES=1
# OSRM response cache TTL in seconds (default 86400).
# OSRM_CACHE_TTL=86400
# Assumed driving speed in m/s for the straight-line fallback (default 11.11,
# ~40 km/h).
# OSRM_FALLBACK_SPEED_MPS=11.11

